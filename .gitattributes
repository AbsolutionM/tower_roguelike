# Godot-Projektdateien sind Text und sollen auf jedem Geraet gleich aussehen.
# Ohne das streiten sich Windows (CRLF) und iPadOS (LF) bei jedem Speichern.
* text=auto eol=lf

*.gd    text eol=lf
*.tscn  text eol=lf
*.tres  text eol=lf
*.godot text eol=lf
*.cfg   text eol=lf
*.md    text eol=lf
*.json  text eol=lf
*.txt   text eol=lf
*.import text eol=lf

# Grafik und Ton sind binaer - nie umkodieren.
*.png      binary
*.jpg      binary
*.aseprite binary
*.wav      binary
*.ogg      binary
*.mp3      binary
*.ttf      binary
