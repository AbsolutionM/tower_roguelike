[resource]
script = ExtResource("1_script")
tower_id = "tower_1"
tower_name = "Grünwald"
description = "Turmstufe 1. Wald, Moos und Nebel - und überall Schleim. Fünf Etagen, jede mit einem Wächter, oben wartet der Schleimkönig."
accent_color = Color(0.55, 0.95, 0.6, 1)
tileset = ExtResource("13_tiles")
ambient_color = Color(0.6, 0.62, 0.76, 1)
floors = 5
rooms = Array[RoomData]([ExtResource("2_room1"), ExtResource("3_room2"), ExtResource("4_room3"), ExtResource("5_room4"), ExtResource("6_room5"), ExtResource("7_room6"), ExtResource("12_belfry"), ExtResource("8_boss")])
weather_options = Array[WeatherData]([ExtResource("9_clear"), ExtResource("10_fog"), ExtResource("11_rain")])
unlocked = true
damage_mult = 1.0
mini_bosses = Array[EnemyData]([ExtResource("mb_miniboss_slime_mother"), ExtResource("mb_miniboss_spider_mother")])
mini_boss_room = ExtResource("mb_room")
