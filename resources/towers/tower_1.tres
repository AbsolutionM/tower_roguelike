[ext_resource type="Resource" path="res://resources/rooms/room_arena.tres" id="6_room5"]
[ext_resource type="Resource" path="res://resources/rooms/room_elite.tres" id="7_room6"]
[ext_resource type="Resource" path="res://resources/rooms/room_boss.tres" id="8_boss"]
[ext_resource type="Resource" path="res://resources/rooms/room_belfry.tres" id="12_belfry"]
