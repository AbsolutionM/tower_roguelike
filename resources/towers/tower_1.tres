[gd_resource type="Resource" script_class="TowerData" format=3]

[ext_resource type="Script" path="res://resources/towers/tower_data.gd" id="1_script"]
[ext_resource type="Resource" path="res://resources/rooms/room_easy.tres" id="2_room1"]
[ext_resource type="Resource" path="res://resources/rooms/room_swarm.tres" id="3_room2"]
[ext_resource type="Resource" path="res://resources/rooms/room_mixed.tres" id="4_room3"]
