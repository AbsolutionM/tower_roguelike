chance = 1.0
count_min = 10
count_max = 15

[resource]
script = ExtResource("1_table")
entries = Array[DropEntry]([SubResource("Entry_heart"), SubResource("Entry_core"), SubResource("Entry_essence"), SubResource("Entry_key"), SubResource("Entry_x101")])
gold_item = ExtResource("3_gold")
gold_chance = 1.0
gold_min = 15
gold_max = 30
