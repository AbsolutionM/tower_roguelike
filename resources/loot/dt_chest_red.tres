[gd_resource type="Resource" script_class="DropTable" format=3]

[ext_resource type="Script" path="res://resources/loot/drop_table.gd" id="1_table"]
[ext_resource type="Script" path="res://resources/loot/drop_entry.gd" id="2_entry"]
[ext_resource type="Resource" path="res://resources/items/gold_coin.tres" id="3_gold"]
[ext_resource type="Resource" path="res://resources/items/soul_heart.tres" id="4_soul"]
[ext_resource type="Resource" path="res://resources/items/essence_slime.tres" id="5_essence"]
[ext_resource type="Resource" path="res://resources/items/crystal_shard.tres" id="6_crystal"]

[sub_resource type="Resource" id="Entry_soul"]
